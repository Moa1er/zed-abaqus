; conservative indentation rules for abaqus structural blocks

(step_block
  (step_keyword_line) @start
  (end_step_keyword_line) @end) @indent

(part_block
  (part_keyword_line) @start
  (end_part_keyword_line) @end) @indent

(assembly_block
  (assembly_keyword_line) @start
  (end_assembly_keyword_line) @end) @indent

(instance_block
  (instance_keyword_line) @start
  (end_instance_keyword_line) @end) @indent
