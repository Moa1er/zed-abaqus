{
  "Heading": {
    "prefix": "heading",
    "body": [
      "*Heading",
      "${1:** job description}",
      "$0"
    ],
    "description": "Abaqus model heading"
  },
  "Node": {
    "prefix": "node",
    "body": [
      "*Node${1:, nset=${2:AllNodes}}",
      "${3:1}, ${4:0.0}, ${5:0.0}, ${6:0.0}",
      "$0"
    ],
    "description": "Node definition block"
  },
  "Element": {
    "prefix": "element",
    "body": [
      "*Element, type=${1:C3D8R}${2:, elset=${3:AllElements}}",
      "${4:1}, ${5:1}, ${6:2}, ${7:3}, ${8:4}, ${9:5}, ${10:6}, ${11:7}, ${12:8}",
      "$0"
    ],
    "description": "Element definition block"
  },
  "Node set": {
    "prefix": "nset",
    "body": [
      "*Nset, nset=${1:Set-1}${2:, generate}",
      "${3:1, 10, 1}",
      "$0"
    ],
    "description": "Node set definition"
  },
  "Element set": {
    "prefix": "elset",
    "body": [
      "*Elset, elset=${1:Set-1}${2:, generate}",
      "${3:1, 10, 1}",
      "$0"
    ],
    "description": "Element set definition"
  },
  "Material": {
    "prefix": "material",
    "body": [
      "*Material, name=${1:Material-1}",
      "${2:*Density\n7850.0,}",
      "$0"
    ],
    "description": "Material definition"
  },
  "Elastic": {
    "prefix": "elastic",
    "body": [
      "*Elastic${1:, type=isotropic}",
      "${2:210000.0}, ${3:0.3}",
      "$0"
    ],
    "description": "Linear elastic material properties"
  },
  "Ogden hyperelastic": {
    "prefix": "ogden",
    "body": [
      "*Hyperelastic, ogden, n=${1:2}",
      "${2:1.0}, ${3:1.0}, ${4:1.0}, ${5:1.0}, ${6:1.0}, ${7:1.0}",
      "$0"
    ],
    "description": "Ogden hyperelastic material formulation"
  },
  "Solid section": {
    "prefix": "solid section",
    "body": [
      "*Solid Section, elset=${1:AllElements}, material=${2:Material-1}",
      "${3:,}",
      "$0"
    ],
    "description": "Solid section assignment"
  },
  "Boundary": {
    "prefix": "boundary",
    "body": [
      "*Boundary",
      "${1:NodeSet}, ${2:1}, ${3:3}, ${4:0.0}",
      "$0"
    ],
    "description": "Boundary condition specification"
  },
  "Amplitude": {
    "prefix": "amplitude",
    "body": [
      "*Amplitude, name=${1:Amp-1}${2:, definition=tabular}",
      "${3:0.0}, ${4:0.0}",
      "${5:1.0}, ${6:1.0}",
      "$0"
    ],
    "description": "Amplitude curve definition"
  },
  "Static step": {
    "prefix": "step",
    "body": [
      "*Step, name=${1:Step-1}${2:, nlgeom=YES, inc=1000}",
      "*Static",
      "${3:0.01}, ${4:1.0}, ${5:1.0e-05}, ${6:0.1}",
      "$10",
      "*End Step",
      "$0"
    ],
    "description": "General static analysis step"
  },
  "Output": {
    "prefix": "output",
    "body": [
      "*Output, field${1:, variable=PRESELECT}",
      "*Node Output",
      "${2:U, RF}",
      "*Element Output, directions=YES",
      "${3:S, E, LE, PE, PEMAG}",
      "$0"
    ],
    "description": "Field output request"
  },
  "Include": {
    "prefix": "include",
    "body": [
      "*Include, input=\"${1:filename.inp}\"",
      "$0"
    ],
    "description": "Include external input deck"
  }
}
